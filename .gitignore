*~
*.swp
*.cfg
*.tmp
*.img
workdir*

bin/
dashboard/app/config_prod.go

# stub file used by Makefile
.descriptions

# coverage report created by make presubmit/test
.coverage.txt

# files generated by syz-sysgen
sys/*/gen/*.go
executor/defs.h
executor/syscalls.h

# produced by gcloud command
dashboard/app/.gcloudignore

# jetbrains goland
.idea

# vscode
.vscode

# Claude Code: per-developer / per-machine working state.
# CLAUDE.md, .claude/README.md, .claude/SESSION_SETUP_PATTERN.md,
# .claude/designs/*.md, .claude/principles/*.md,
# .claude/users/README.md, and .claude/users/.contributors are
# tracked; everything below is local-only.  See .claude/README.md
# and .claude/users/README.md for the full split.
/.claude/tasks/
/.claude/settings.local.json
/.claude/worktrees/
# Private working memory that must never reach the public remote:
# subsystem/maintainer positioning (often sourced from offlist mail),
# and any other strictly-internal notes.  Local-only, never tracked.
/.claude/mptcp/
/.claude/maintainers/
/.claude/private/
# Per-user working memory under .claude/users/<name>/ is local.
# Tracked exceptions are pinned with negative patterns below.
/.claude/users/*/tasks/
/.claude/users/*/notes/
!/.claude/users/README.md
!/.claude/users/.contributors

# Compiled test binaries from kernel_patches/mptcp_kcov/test_*.c
# (the .c sources are tracked; only the build artifacts are local).
kernel_patches/mptcp_kcov/test_mp_*
!kernel_patches/mptcp_kcov/test_mp_*.c
!kernel_patches/mptcp_kcov/test_mp_*.h
# Compiled test binaries when built in repo root.
/test_mp_join_normal
/test_mp_join_backup
/test_mp_join_hmac_bitflip
/test_mp_pm_announce_leak
/test_setsockopt_handle

# Local VM swap files (created by mkswap inside the dev_env VM).
swap-file
/swap-*